# Copy to .env on the worker box. Never commit .env.

# --- required ---------------------------------------------------------------
HRX_TENANT_ID=BCiP2bQ9CgVOCTfV6MhD
# Service account JSON with Firestore + Storage (+ optionally Secret Manager) access.
GOOGLE_APPLICATION_CREDENTIALS=/Users/<you>/.config/gcloud-hrx/portal-worker-sa.json

# --- identity ---------------------------------------------------------------
# Defaults to <hostname>-<pid>. Set a stable name per box so heartbeats are readable.
PORTAL_WORKER_ID=office-mini-1
# Comma list; defaults to both.
PORTAL_PROVIDERS=indeed_flex,fieldglass

# --- portal bot credentials (preferred: Secret Manager, see README) ----------
# Env fallback for a laptop test run. Leave unset to use Secret Manager
# (${PORTAL_SECRET_PREFIX}-<provider>-username / -password).
# INDEED_FLEX_BOT_USERNAME=
# INDEED_FLEX_BOT_PASSWORD=
# FIELDGLASS_BOT_USERNAME=
# FIELDGLASS_BOT_PASSWORD=
PORTAL_SECRET_PREFIX=portal-worker

# --- browser ----------------------------------------------------------------
# Headed by default (a visible Chrome on the worker box). 1 for servers.
PORTAL_HEADLESS=0
# Persistent profiles + failure screenshots (default: ./.data)
# PORTAL_WORKER_DATA_DIR=/Users/<you>/hrx-portal-worker-data
# Upload failure screenshots here so Slack links work; omit to keep them local.
# PORTAL_STORAGE_BUCKET=hrx1-d3beb.appspot.com

# --- alerts -----------------------------------------------------------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_ALERT_CHANNEL_ID=C0123456789

# --- timing (ms) ------------------------------------------------------------
PORTAL_POLL_MS=5000
PORTAL_HEARTBEAT_MS=30000
PORTAL_SWEEP_MS=60000
PORTAL_KEEPALIVE_MS=300000
PORTAL_LEASE_MS=600000
PORTAL_ACTION_MIN_GAP_MS=3000
PORTAL_ACTION_TIMEOUT_MS=240000
# Exit after this long so launchd restarts the process cleanly (12h).
PORTAL_MAX_UPTIME_MS=43200000
# PORTAL_LOG_DEBUG=1
