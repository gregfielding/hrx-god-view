{
  "name": "hrx-portal-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on worker that executes HRX portal_actions in the Indeed Flex agency portal and SAP Fieldglass via Playwright.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "enqueue": "tsx scripts/enqueue.ts",
    "status": "tsx scripts/status.ts",
    "login": "tsx scripts/login-debug.ts",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.4.0",
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
