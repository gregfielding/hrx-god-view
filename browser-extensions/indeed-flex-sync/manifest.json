{
  "manifest_version": 3,
  "name": "HRX Indeed Flex Sync",
  "version": "1.1.0",
  "description": "Syncs Indeed Flex agency-portal jobs (job, shifts, booked roster) and the Timesheets view into HRX automatically as you browse.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://agency.indeedflex.com/*",
    "https://flex-core-us.indeed.com/*",
    "https://us-central1-hrx1-d3beb.cloudfunctions.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://agency.indeedflex.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://agency.indeedflex.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HRX Indeed Flex Sync"
  },
  "options_page": "options.html"
}
